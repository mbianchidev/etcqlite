# Local developer artifacts only. This file is deliberately not an active workflow.
name: Native developer packages
on:
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: native-packages-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: false
jobs:
  package:
    timeout-minutes: 40
    strategy:
      fail-fast: true
      max-parallel: 2
      matrix:
        os: [ubuntu-24.04-arm, macos-15]
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16 # v6
        with:
          go-version: 1.27.x
          cache-dependency-path: tools/go.sum
      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6
        with:
          python-version: '3.12'
      - uses: dtolnay/rust-toolchain@b725eda525362e7cf34af9a7243cac1e3f01a7ec
        with:
          toolchain: 1.99.1
      - uses: actions/cache@caa296126883cff596d87d8935842f9db880ef25 # v5
        with:
          path: |
            ~/.cargo/registry
            ~/.cargo/git
            target/distribution-build
          key: package-${{ runner.os }}-${{ runner.arch }}-1.99.1-${{ hashFiles('Cargo.lock', 'Cargo.toml', 'build.rs', 'proto/**', 'vendor/**') }}
          restore-keys: package-${{ runner.os }}-${{ runner.arch }}-1.99.1-
      - name: Prepare native prerequisites
        shell: bash
        run: |
          set -euo pipefail
          workers=2
          if [ "$(getconf _NPROCESSORS_ONLN)" -lt 2 ]; then
            workers=1
            echo "::warning::Runner has one CPU; packaging uses one worker"
          fi
          {
            echo "CARGO_BUILD_JOBS=$workers"
            echo "GOMAXPROCS=$workers"
            echo "PYTHONDONTWRITEBYTECODE=1"
          } >> "$GITHUB_ENV"
          if ! command -v protoc; then
            if [ "$RUNNER_OS" = Linux ]; then
              sudo apt-get update -qq
              sudo apt-get install -y protobuf-compiler
            else
              brew install protobuf
            fi
          fi
      - name: Verify installer and build a native package once
        run: |
          make test-distribution
          bash script/release.sh --dry-run
          bash script/release.sh --jobs "$CARGO_BUILD_JOBS"
      - uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6
        with:
          name: etcqlite-dev-${{ runner.os }}-${{ runner.arch }}-${{ github.sha }}
          path: |
            target/dist/*.tar.gz
            target/dist/*.sha256
            target/dist/*.provenance.json
          if-no-files-found: error
          retention-days: 7
