# Intentionally inactive: only .yml/.yaml are GitHub Actions workflows.
name: Native validation
on:
  pull_request:
    types: [ready_for_review]
  push:
    branches: [main]
  workflow_dispatch:
    inputs:
      pr_number:
        description: Open PR number to validate; dispatch against its current branch
        required: true
        type: string
      head_sha:
        description: Exact current PR head; must also equal this run's SHA
        required: true
        type: string
permissions:
  contents: read
  pull-requests: read
concurrency:
  group: native-validation-${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true
jobs:
  validate:
    timeout-minutes: 35
    strategy:
      fail-fast: true
      max-parallel: 2
      matrix:
        include:
          - os: ubuntu-24.04-arm
            go: 1.26.x
          - os: macos-15
            go: 1.27.x
    runs-on: ${{ matrix.os }}
    steps:
      - name: Validate manual PR identity
        if: github.event_name == 'workflow_dispatch'
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
          PR_NUMBER: ${{ inputs.pr_number }}
          EXPECTED_HEAD: ${{ inputs.head_sha }}
        shell: bash
        run: |
          set -euo pipefail
          [[ "$PR_NUMBER" =~ ^[1-9][0-9]*$ ]]
          [[ "$EXPECTED_HEAD" =~ ^[0-9a-f]{40}$ ]]
          test "$GITHUB_SHA" = "$EXPECTED_HEAD"
          test "$(gh api "repos/$GH_REPO/pulls/$PR_NUMBER" --jq .state)" = open
          test "$(gh api "repos/$GH_REPO/pulls/$PR_NUMBER" --jq .head.sha)" = "$EXPECTED_HEAD"
          test "$(gh api "repos/$GH_REPO/pulls/$PR_NUMBER" --jq .head.repo.full_name)" = "$GH_REPO"
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
        with:
          persist-credentials: false
      - uses: actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16 # v6
        with:
          go-version: ${{ matrix.go }}
          cache-dependency-path: tools/go.sum
      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6
        with:
          python-version: '3.12'
      - uses: dtolnay/rust-toolchain@b725eda525362e7cf34af9a7243cac1e3f01a7ec # stable action
        with:
          toolchain: 1.99.1
          components: rustfmt, clippy
      - uses: actions/cache@caa296126883cff596d87d8935842f9db880ef25 # v5
        with:
          path: |
            ~/.cargo/registry
            ~/.cargo/git
            target/debug
          key: rust-${{ runner.os }}-${{ runner.arch }}-1.99.1-${{ hashFiles('Cargo.lock', 'Cargo.toml', 'build.rs', 'proto/**', 'vendor/**') }}
          restore-keys: rust-${{ runner.os }}-${{ runner.arch }}-1.99.1-
      - name: Set bounded worker budget and install missing protoc
        shell: bash
        run: |
          set -euo pipefail
          workers=2
          if [ "$(getconf _NPROCESSORS_ONLN)" -lt 2 ]; then
            workers=1
            echo "::warning::Runner has one CPU; validation uses one worker"
          fi
          {
            echo "CI_WORKERS=$workers"
            echo "CARGO_BUILD_JOBS=$workers"
            echo "GOMAXPROCS=$workers"
            echo "PYTHONDONTWRITEBYTECODE=1"
          } >> "$GITHUB_ENV"
          if ! command -v protoc; then
            if [ "$RUNNER_OS" = Linux ]; then
              sudo apt-get update -qq
              sudo apt-get install -y protobuf-compiler
            else
              brew install protobuf
            fi
          fi
      - name: Format and static checks
        run: |
          make fmt
          cargo clippy --locked --all-targets -- -D warnings
          go -C tools vet ./...
      - name: Native and Go tests
        run: |
          cargo test --locked --jobs "$CI_WORKERS" -- --test-threads "$CI_WORKERS"
          go -C tools test -race -p 1 -parallel "$CI_WORKERS" ./...
          make test-campaign test-distribution
          bash -n script/release.sh script/install.sh
          bash script/release.sh --dry-run
      - name: Recheck manual PR head
        if: github.event_name == 'workflow_dispatch'
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
          PR_NUMBER: ${{ inputs.pr_number }}
          EXPECTED_HEAD: ${{ inputs.head_sha }}
        run: test "$(gh api "repos/$GH_REPO/pulls/$PR_NUMBER" --jq .head.sha)" = "$EXPECTED_HEAD"
